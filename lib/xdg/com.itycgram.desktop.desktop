[Desktop Entry]
Name=iTycGram Desktop
Comment=Desktop version of iTycGram - ToS breaking Telegram client
TryExec=iTycGram
Exec=env DESKTOPINTEGRATION=1 iTycGram -- %U
Icon=com.itycgram.desktop
Terminal=false
StartupWMClass=iTycGram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;
Keywords=tg;chat;im;messaging;messenger;sms;telegram;tdesktop;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=iTycGram -quit
Name=Quit iTycGram
Icon=application-exit
